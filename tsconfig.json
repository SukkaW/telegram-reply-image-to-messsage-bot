{
  "compilerOptions": {
    "target": "es2018",
    "module": "preserve",
    "rootDir": "./src",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "declaration": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true
  },
  "include": ["src/**/*", "eslint.config.js", "bot.config.ts"]
}
